<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot" android:orientation="vertical"
    android:layout_width="220dp" android:layout_height="wrap_content"
    android:background="#DDF8F8F8" android:padding="8dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="揭棋辅助" android:textSize="13sp" android:textStyle="bold"
        android:gravity="center" android:textColor="#B22222" />

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp">
        <ToggleButton android:id="@+id/toggleAssist" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:textOn="自动辅助 开" android:textOff="自动辅助 关"
            android:textSize="11sp" />
        <ToggleButton android:id="@+id/toggleAutoMove" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:textOn="自动落子 开" android:textOff="自动落子 关"
            android:textSize="11sp" android:layout_marginLeft="4dp" />
    </LinearLayout>

    <com.jieqi.assistant.overlay.BoardMiniView
        android:id="@+id/boardMini" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" />

    <TextView android:id="@+id/tvStats" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#333333"
        android:paddingTop="4dp" />
    <TextView android:id="@+id/tvMoves" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B22222"
        android:textStyle="bold" android:paddingTop="2dp" />
    <TextView android:id="@+id/tvDiag" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#888888"
        android:paddingTop="2dp" />
</LinearLayout>
